{
  "manifest_version": 3,
  "name": "작은옷장 · 현재 상품 가져오기",
  "version": "0.3.0",
  "description": "일반 Chrome에서 사용자가 직접 연 신상마켓 상품의 검토용 근거를 로컬 작은옷장으로 보냅니다.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://sinsangmarket.kr/*",
    "https://www.sinsangmarket.kr/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "작은옷장으로 현재 상품 가져오기"
  }
}
